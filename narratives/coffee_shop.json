                    "participant": "Cart",
                    "role": "shopping_cart"
                },
                {
                    "name": "invoke",
                    "behaviorName": "visitShop",
                    "args": []
                }
            ]
        },
        {
            "name": "behavior",
            "behaviorName": "visitShop",
            "attributes": [],
            "body": [
                {
                    "name": "terminal_display",
